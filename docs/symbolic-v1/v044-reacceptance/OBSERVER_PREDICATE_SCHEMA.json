{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "composition": {
          "const": "observed_word_equality"
        },
        "prototype_tokens": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "prototype_record_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "equality": {
          "const": "literal_tokens_only"
        }
      },
      "required": [
        "composition",
        "prototype_tokens",
        "prototype_record_ref",
        "max_tokens",
        "equality"
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "composition": {
          "const": "observed_word_equality"
        },
        "prototype_tokens": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "prototype_record_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "equality": {
          "const": "literal_tokens_only"
        }
      },
      "required": [
        "composition",
        "prototype_tokens",
        "prototype_record_ref",
        "max_tokens",
        "equality"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "composition": {
          "const": "observed_context_scan"
        },
        "parent_feature_ref": {
          "type": "string",
          "pattern": "^derived_[0-9a-f]{20}$"
        },
        "predicate_ast": {
          "$ref": "#/$defs/anchor"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "scan": {
          "const": "all_contiguous_positions"
        },
        "frame_operations": {
          "const": [
            "SPLIT",
            "SPLIT",
            "CONCAT",
            "CONCAT"
          ]
        }
      },
      "required": [
        "composition",
        "parent_feature_ref",
        "predicate_ast",
        "max_tokens",
        "scan",
        "frame_operations"
      ]
    }
  ],
  "description": "Syntactic reference; source ownership, parent identity, label scope, invariance and operator traces require independent semantic checking."
}
