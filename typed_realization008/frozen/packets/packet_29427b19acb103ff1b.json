      "edition": "Ripley1591/TCP-aa59eb69/public-projection004",
      "start": 1238,
      "end": 1285,
      "text": "That poynt therefore I will disclose vnto thee,",
      "source_address": {
        "xml_path": "/TEI/text/body/div[3]/div[9]/lg[5]/l[1]",
        "section": "gate9",
        "stanza": 5,
