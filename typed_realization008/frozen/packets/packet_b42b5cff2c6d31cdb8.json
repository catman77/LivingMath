      "edition": "Ripley1591/TCP-aa59eb69/public-projection004",
      "start": 0,
      "end": 49,
      "text": "And we dissolue into water which wetteth no hand,",
      "source_address": {
        "xml_path": "/TEI/text/body/div[3]/div[2]/lg[5]/l[1]",
        "section": "gate2",
        "stanza": 5,
        "line": 1,
