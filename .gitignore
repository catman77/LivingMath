# Publish only current source, installation material and reviewed proposal support.
# Historical runs and archives remain on disk, outside Git history.
# Exact pre-existing test inputs are tracked explicitly; their SHA inventory is
# assets/test-fixtures.manifest.json (including one required immutable ZIP).
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/CONTRIBUTING.md
!/THIRD_PARTY_NOTICES.md
!/.github/
!/live_math_mcp_prod/
!/assets/
!/suti_author_proposals/
!/docs/
/docs/*
!/docs/INSTALL.md
!/docs/USAGE.md
!/docs/TESTING.md
!/docs/RESEARCH_STATUS.md
!/docs/PUBLICATION.md
!/docs/CI_STATUS.md
!/docs/publication-checks.json
!/docs/examples/
/docs/examples/*
!/docs/examples/research_autonomy_ingest.artifact.json
!/docs/examples/research_autonomy_ingest.meaning014.json
!/docs/examples/rights.schema.json
!/bridge002/
/bridge002/*
!/bridge002/report.md
!/bridge002/SUTI_EXPORT_PROPOSAL_v0.1.md
!/bridge002/bridge001-dependency.json
!/bridge002/bridge2/
!/bridge002/schemas/
!/bridge002/vendor/
!/bridge003/
/bridge003/*
!/bridge003/report.md
!/bridge003/witnesses.jsonl
!/bridge004/
/bridge004/*
!/bridge004/report.md
!/bridge004/RCA.md
!/alch006/
/alch006/*
!/alch006/final-model.json
!/artifact_release009/
/artifact_release009/*
!/artifact_release009/frozen/
!/meaning_pivot014/
/meaning_pivot014/*
!/meaning_pivot014/metrics.json
!/meaning_pivot014/RCA.md
!/meaning_pivot014/USER_MODEL_REPORT.md

# Private state and generated output, at every level.
.venv/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.codex/
.codex-attachments/
.gstack/
*.pyc
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.zip
*.tar.gz
*.log
*.pem
*.key
*.p12
*.pfx
.env
.env.*
auth.json
owner-password
login-password
inference-spool/
