  "required": [
    "schema_version",
    "normalizer_version",
    "project",
    "focus",
    "level",
    "status",
    "input_digest",
    "source_catalog",
    "concepts",
    "interpretations",
    "audit_context",
    "coverage",
    "unresolved",
    "loss_ledger",
    "certificate",
    "proof_status"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LivingMath source-preserving normalization view v1"
}
