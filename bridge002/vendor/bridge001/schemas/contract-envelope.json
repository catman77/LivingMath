      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "scope": {
          "type": "array",
          "items": {
            "enum": [
              "local_process",
              "local_export",
              "mcp_metadata",
              "remote_source"
            ]
          },
          "maxItems": 128
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expires_at": {
              "type": "string",
              "format": "date-time"
