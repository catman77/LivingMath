      "edition": "Ripley1591/TCP-A10786-aa59eb69",
      "start": 1689,
      "end": 1728,
      "text": "But what it is, I will to thee declare;",
      "source_address": {
        "old_public_line_id": "line-01292",
        "xml_path": "/TEI[1]/text[1]/body[1]/div[3]/div[6]/lg[1]/l[2]",
