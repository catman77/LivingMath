      "edition": "Ripley1591/TCP-A10786-aa59eb69",
      "start": 1729,
      "end": 1777,
      "text": "It is of soft things induration of colour white,",
      "source_address": {
        "old_public_line_id": "line-01293",
        "xml_path": "/TEI[1]/text[1]/body[1]/div[3]/div[6]/lg[1]/l[3]",
