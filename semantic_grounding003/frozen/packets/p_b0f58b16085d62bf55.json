      "edition": "Ripley1591/TCP-A10786-aa59eb69",
      "start": 1198,
      "end": 1243,
      "text": "And so promoted vnto most perfect temperance,",
      "source_address": {
        "xml_path": "/TEI/text/body/div[3]/div[4]/lg[4]/l[6]",
        "gate": 4,
        "stanza": 4,
        "line": 6,
        "upstream_sha256": "2f0265dc83f8d64a6fcd5fefd61bae4861cd2ac65c3bb0579f0b0837c457ba8b"
      }
    },
