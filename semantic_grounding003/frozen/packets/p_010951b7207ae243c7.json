      "edition": "Ripley1591/TCP-A10786-aa59eb69",
      "start": 802,
      "end": 849,
      "text": "Therefore the soule first from the bodie twyne,",
      "source_address": {
        "xml_path": "/TEI/text/body/div[3]/div[4]/lg[3]/l[5]",
        "gate": 4,
        "stanza": 3,
        "line": 5,
        "upstream_sha256": "2f0265dc83f8d64a6fcd5fefd61bae4861cd2ac65c3bb0579f0b0837c457ba8b"
      }
    },
    {
