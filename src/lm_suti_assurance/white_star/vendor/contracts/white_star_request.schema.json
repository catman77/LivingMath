{
  "type": "object",
  "properties": {
    "schema": {
      "const": "levinmas-white-star-request/1"
    },
    "encoding": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "llm-white-star-concepts/1"
        },
        "source": {
          "type": "object",
          "properties": {
            "author": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48000
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "rights": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "author",
            "title",
            "text",
            "sha256",
            "rights"
          ],
          "additionalProperties": false
        },
        "axes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "minus": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "plus": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "id",
              "minus",
              "plus"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 2
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "line": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 48000
                    },
                    "byte_start": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 48000
                    },
                    "byte_end": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 48000
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 48000
                    }
                  },
                  "required": [
                    "line",
                    "byte_start",
                    "byte_end",
                    "quote"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 256
              },
              "coordinates": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "minItems": 2,
                "maxItems": 2
              },
              "encoding_rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              }
            },
            "required": [
              "id",
              "label",
              "evidence",
              "coordinates",
              "encoding_rationale"
            ],
            "additionalProperties": false
          },
          "minItems": 3,
          "maxItems": 64
        },
        "source_relations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "concepts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "minItems": 1,
                "maxItems": 64
              },
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              }
            },
            "required": [
              "id",
              "concepts",
              "kind",
              "note"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 512
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "minItems": 0,
          "maxItems": 128
        },
        "protocol": {
          "type": "object",
          "properties": {
            "seed": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "candidates_per_step": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "frame_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "decode_first_frames": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "exclude_zero_direction": {
              "const": true
            },
            "semantic_reranking": {
              "const": false
            },
            "optimizer_feedback": {
              "const": false
            },
            "selection": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "output_selection": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "objective": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "seed",
            "steps",
            "candidates_per_step",
            "frame_size",
            "decode_first_frames"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object"
        },
        "coordinate_status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "schema",
        "source",
        "axes",
        "concepts",
        "source_relations",
        "uncertainties",
        "protocol"
      ],
      "additionalProperties": false
    },
    "atlas_profile": {
      "enum": [
        "base_v1",
        "cj_v1"
      ],
      "default": "cj_v1"
    }
  },
  "required": [
    "schema",
    "encoding"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:levinmas:white-star:request:1",
  "title": "Proposed White Star request; semantic and byte-limit checks are additionally required"
}
