{
  "type": "object",
  "properties": {
    "schema": {
      "const": "lm-suti.semantic.source-anchor/1"
    },
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "source_snapshot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "origin_kind": {
      "enum": [
        "TRUSTED_CONTEXT",
        "DERIVED",
        "HOSTED_MODEL",
        "MANUAL",
        "FIXTURE"
      ]
    },
    "producer_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "parent_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "minItems": 0
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_permission": {
      "const": false
    },
    "source_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "edition_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "byte_start": {
      "type": "integer",
      "minimum": 0
    },
    "byte_end": {
      "type": "integer",
      "minimum": 1
    },
    "quote_utf8": {
      "type": "string",
      "minLength": 1
    },
    "quote_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "unit": {
      "const": "source_utf8_bytes"
    },
    "line_index_rule": {
      "const": "LF_EXACT_UTF8_V1"
    },
    "line_number": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema",
    "schema_version",
    "project_id",
    "source_snapshot_digest",
    "origin_kind",
    "producer_ref",
    "created_by",
    "parent_refs",
    "content_digest",
    "execution_permission",
    "source_ref",
    "edition_ref",
    "source_sha256",
    "byte_start",
    "byte_end",
    "quote_utf8",
    "quote_sha256",
    "unit",
    "line_index_rule",
    "line_number"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
