{
  "type": "object",
  "properties": {
    "schema": {
      "const": "lm-suti.semantic.source-edition/1"
    },
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "source_snapshot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "origin_kind": {
      "enum": [
        "TRUSTED_CONTEXT",
        "DERIVED",
        "HOSTED_MODEL",
        "MANUAL",
        "FIXTURE"
      ]
    },
    "producer_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "parent_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "minItems": 0
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_permission": {
      "const": false
    },
    "source_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "edition": {
      "type": "string",
      "minLength": 1
    },
    "editorial_source_url": {
      "type": "string"
    },
    "edition_status": {
      "enum": [
        "PUBLIC_TRANSCRIPTION_LINE_MATCH",
        "UNCERTAIN_EDITION",
        "DECLARED_EDITION"
      ]
    },
    "rights": {
      "type": "object"
    },
    "publication_policy": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "owner_review_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema",
    "schema_version",
    "project_id",
    "source_snapshot_digest",
    "origin_kind",
    "producer_ref",
    "created_by",
    "parent_refs",
    "content_digest",
    "execution_permission",
    "source_ref",
    "source_sha256",
    "source_id",
    "author",
    "title",
    "edition",
    "editorial_source_url",
    "edition_status",
    "rights",
    "publication_policy",
    "provenance",
    "scope",
    "owner_review_reason"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
