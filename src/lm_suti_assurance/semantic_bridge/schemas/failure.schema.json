{
  "type": "object",
  "properties": {
    "schema": {
      "const": "lm-suti.semantic.failure/1"
    },
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "source_snapshot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "origin_kind": {
      "enum": [
        "TRUSTED_CONTEXT",
        "DERIVED",
        "HOSTED_MODEL",
        "MANUAL",
        "FIXTURE"
      ]
    },
    "producer_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "parent_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "minItems": 0
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_permission": {
      "const": false
    },
    "proposal_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "field": {
      "type": [
        "string",
        "null"
      ]
    },
    "registration_state": {
      "const": "FRAME_UNTRUSTED"
    },
    "preflight_decision": {
      "const": "REJECTED"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "project_id",
    "source_snapshot_digest",
    "origin_kind",
    "producer_ref",
    "created_by",
    "parent_refs",
    "content_digest",
    "execution_permission",
    "proposal_ref",
    "reason_code",
    "field",
    "registration_state",
    "preflight_decision"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
