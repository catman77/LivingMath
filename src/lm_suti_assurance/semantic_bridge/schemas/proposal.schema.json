{
  "type": "object",
  "properties": {
    "schema": {
      "const": "lm-suti.semantic.proposal/1"
    },
    "literal_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text",
          "quote"
        ],
        "additionalProperties": false
      },
      "minItems": 2
    },
    "interpretations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "INTERPRETATION",
              "FORMAL_STRUCTURE",
              "UNRESOLVED"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "premises": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "kind",
          "text",
          "evidence",
          "premises",
          "alternatives"
        ],
        "additionalProperties": false
      },
      "minItems": 2
    },
    "motifs": {
      "type": "array",
