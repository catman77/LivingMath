    "temporal_reading": {
      "enum": [
        "cyclic",
        "spiral",
        "linear",
        "ambiguous",
        "unspecified"
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
