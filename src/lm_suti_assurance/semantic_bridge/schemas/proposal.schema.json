        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "label",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 2
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "PRECEDES",
              "REPEATS_MOTIF",
              "CONTRASTS",
              "CHANGES_SPEAKER_ROLE",
              "CAUSES_IN_NARRATIVE"
