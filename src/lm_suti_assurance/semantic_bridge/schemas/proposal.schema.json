      "type": "string",
      "minLength": 1
    },
    "claimed_invariants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema",
    "literal_observations",
    "interpretations",
    "motifs",
    "relations",
    "temporal_reading",
    "assumptions",
    "limitations",
    "open_questions",
    "counterreadings",
    "observables",
    "revision_rationale",
    "claimed_invariants"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
